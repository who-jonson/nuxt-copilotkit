{
  "name": "@whoj/nuxt-copilotkit",
  "version": "0.0.1",
  "description": "SSR-safe CopilotKit integration for Nuxt — built-in Nitro runtime route, GenUI/HITL helpers, and a devtools tab",
  "license": "MIT",
  "type": "module",
  "repository": "who-jonson/nuxt-copilotkit",
  "homepage": "https://github.com/who-jonson/nuxt-copilotkit",
  "bugs": {
    "url": "https://github.com/who-jonson/nuxt-copilotkit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build && npm run client:build",
    "client:build": "nuxi generate client",
    "client:dev": "nuxi dev client --port 3300",
    "dev": "npm run play:dev",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare client && nuxi prepare playground",
    "prepare": "nuxi prepare client && skills-npm -a 'claude,pi'",
    "play:dev": "nuxi dev playground",
    "play:prod": "npm run prepack && nuxi dev playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && vitest run -c vitest.unit.config.ts",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd client && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "catalog:prod",
    "@nuxt/kit": "catalog:prod",
    "sirv": "catalog:prod"
  },
  "peerDependencies": {
    "@copilotkit/runtime": "catalog:prod",
    "@copilotkit/vue": "catalog:prod"
  },
  "peerDependenciesMeta": {
    "@copilotkit/runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@copilotkit/runtime": "catalog:prod",
    "@copilotkit/vue": "catalog:prod",
    "@iconify-json/carbon": "catalog:dev",
    "@nuxt/content": "catalog:dev",
    "@nuxt/devtools": "catalog:dev",
    "@nuxt/devtools-ui-kit": "catalog:dev",
    "@nuxt/eslint-config": "catalog:dev",
    "@nuxt/module-builder": "catalog:dev",
    "@nuxt/schema": "catalog:dev",
    "@nuxt/test-utils": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript/native": "catalog:dev",
    "changelogen": "catalog:dev",
    "eslint": "catalog:dev",
    "nuxt": "catalog:dev",
    "rxjs": "catalog:dev",
    "skills-npm": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev"
  },
  "packageManager": "pnpm@12.15.0",
  "author": {
    "name": "B. Jonson",
    "url": "https://whoj.dev"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
